{
  "name": "mel-e-minie-tutor-pc",
  "version": "4.0.0",
  "private": true,
  "main": "dist-electron/main/electron-main.mjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test tests/e2e",
    "test:layout": "playwright test tests/layout",
    "test:overlay": "playwright test tests/overlay",
    "build:win": "npm run build && npm run build:electron && electron-builder --win nsis --config electron-builder.json"
  },
  "dependencies": {
    "electron": "^31.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "autoprefixer": "^10.4.20",
    "electron-builder": "^24.13.3",
    "eslint": "^9.17.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vitest": "^2.1.8"
  }
}
